                "申请",
                "渠道"
              ],
              "intents": [
                "count"
              ]
            },
            "template": "查询当前已采集的贷款申请数据，按申请渠道分组统计申请笔数。"
          },
          {
            "match": {
              "all": [
                "申请"
              ],
              "intents": [
                "count",
                "trend",
                "region"
              ]
            },
            "template": "查询各申请区域按月份的贷款申请笔数变化趋势。"
          },
          {
            "match": {
              "all": [
                "申请"
              ],
              "intents": [
                "count",
                "trend",
                "product"
              ]
            },
            "template": "查询贷款申请按月份统计各贷款产品类型的申请笔数变化趋势。"
          },
          {
            "match": {
              "all": [
                "申请"
              ],
              "intents": [
                "count",
                "trend"
              ]
            },
            "template": "查询贷款申请笔数按月份的变化趋势。"
          },
          {
            "match": {
              "all": [
                "申请"
              ],
              "intents": [
                "count",
                "region"
              ]
            },
            "template": "查询贷款申请按申请区域分组的申请笔数，并按申请笔数降序排序{top_n_suffix}。"
