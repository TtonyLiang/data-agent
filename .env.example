# LLM 配置 (OpenAI 兼容接口)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:14b

# Embedding 配置
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_MODEL=embedding-3

# MySQL 业务数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=business_db

# MySQL 管理数据库
MANAGEMENT_MYSQL_HOST=127.0.0.1
MANAGEMENT_MYSQL_PORT=3306
MANAGEMENT_MYSQL_USER=root
MANAGEMENT_MYSQL_PASSWORD=root
MANAGEMENT_MYSQL_DATABASE=dataquery_agent

# Milvus 向量数据库
# 默认使用本地 Milvus 服务；如需 Lite 模式，可改成 ./data/milvus.db
MILVUS_URI=http://127.0.0.1:19530
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=dataquery_knowledge

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=4400
DEBUG=true

# 安全配置
# 开发环境可留空跳过鉴权；生产环境 DEBUG=false 时必须配置。
ADMIN_API_KEY=
JWT_SECRET_KEY=
# 初次初始化管理员时显式设置用户名和密码/哈希；已有管理员后无需保留。
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_PASSWORD_HASH=
# 用于加密模型 API Key 和数据源密码，生产环境必须配置稳定密钥。
SECRET_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:4399,http://127.0.0.1:4399,http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT_PER_MINUTE=120
CHAT_STREAM_MAX_CONCURRENT=8
MYSQL_CONNECT_TIMEOUT_SECONDS=10
MYSQL_QUERY_TIMEOUT_SECONDS=30

# 数据定位召回参数
SCHEMA_RECALL_MAX_TABLES=6
SCHEMA_RECALL_REQUIRED_SCORE_RATIO=0.35
SCHEMA_RECALL_OPTIONAL_SCORE_RATIO=0.15
