{
  "domain": {
    "agent_id": 1,
    "datasource_id": null,
    "domain_key": "loan_risk",
    "name": "贷款风控",
    "description": "面向贷款申请、放款、还款、风险快照和催收处置的 Data Agent 语义运行时。"
  },
  "concepts": [
    {"concept_key": "LoanApplication", "concept_type": "object", "name": "贷款申请", "description": "客户提交的贷款申请及审批结果。", "synonyms": ["申请", "进件", "审批申请"]},
    {"concept_key": "LoanAccount", "concept_type": "object", "name": "贷款账户", "description": "审批通过后形成的贷款借据和当前余额状态。", "synonyms": ["借据", "贷款", "账户"]},
    {"concept_key": "RepaymentPeriod", "concept_type": "object", "name": "还款期次", "description": "每一笔贷款的分期应还、实还和逾期表现。", "synonyms": ["期次", "账单", "还款计划"]},
    {"concept_key": "CustomerRiskSnapshot", "concept_type": "object", "name": "客户月度风险快照", "description": "客户在某个月的风险评分、负债压力和行为表现。", "synonyms": ["客户风险", "月度风险", "风险画像"]},
    {"concept_key": "CollectionCase", "concept_type": "object", "name": "催收案件", "description": "逾期账户进入催收后的分案、触达、承诺和回收情况。", "synonyms": ["催收", "催收工单", "入催案件"]},
    {"concept_key": "ApplySubmitted", "concept_type": "event", "name": "提交申请", "description": "客户发起贷款申请。", "synonyms": ["申请提交", "进件"]},
    {"concept_key": "ApplicationApproved", "concept_type": "event", "name": "审批通过", "description": "申请被审批通过并授予额度。", "synonyms": ["批核", "通过"]},
    {"concept_key": "LoanDisbursed", "concept_type": "event", "name": "放款", "description": "贷款本金实际发放给客户。", "synonyms": ["发放", "放款成功"]},
    {"concept_key": "RepaymentDue", "concept_type": "event", "name": "到期应还", "description": "还款期次到达应还日。", "synonyms": ["应还", "账单到期"]},
    {"concept_key": "RepaymentPaid", "concept_type": "event", "name": "还款入账", "description": "客户完成部分或全部还款。", "synonyms": ["实还", "还款"]},
    {"concept_key": "OverdueEntered", "concept_type": "event", "name": "进入逾期", "description": "贷款或期次产生逾期天数。", "synonyms": ["逾期", "DPD"]},
    {"concept_key": "CollectionStarted", "concept_type": "event", "name": "入催", "description": "逾期账户进入催收处置。", "synonyms": ["分案", "进入催收"]},
    {"concept_key": "WriteOffConfirmed", "concept_type": "event", "name": "核销确认", "description": "账户进入损失确认口径。", "synonyms": ["坏账核销", "核销"]},
    {"concept_key": "ApprovalStatus", "concept_type": "state", "name": "审批状态", "description": "申请的审批状态。", "synonyms": ["审批结果"]},
    {"concept_key": "LoanStatus", "concept_type": "state", "name": "贷款当前状态", "description": "贷款账户当前生命周期状态。", "synonyms": ["账户状态"]},
    {"concept_key": "OverdueBucket", "concept_type": "state", "name": "逾期阶段", "description": "按逾期天数划分的 M0/M1/M2/M3/M4+ 阶段。", "synonyms": ["M段", "逾期桶"]},
    {"concept_key": "CollectionStatus", "concept_type": "state", "name": "催收案件状态", "description": "催收案件当前处理状态。", "synonyms": ["案件状态"]},
    {"concept_key": "RiskGrade", "concept_type": "state", "name": "风险等级", "description": "客户、申请或账户的风险分层。", "synonyms": ["评级", "风控等级"]}
  ],
  "relations": [
    {"relation_key": "application_to_account", "relation_type": "join_path", "source_concept": "LoanApplication", "target_concept": "LoanAccount", "name": "申请到账户", "description": "审批通过的申请可形成贷款账户。", "join_path": [{"left": "loan_application_indicator.application_id", "right": "loan_account_indicator.application_id"}]},
    {"relation_key": "account_to_repayment", "relation_type": "join_path", "source_concept": "LoanAccount", "target_concept": "RepaymentPeriod", "name": "账户到还款期次", "description": "一个贷款账户包含多个还款期次。", "join_path": [{"left": "loan_account_indicator.loan_id", "right": "loan_repayment_period_indicator.loan_id"}]},
    {"relation_key": "account_to_collection", "relation_type": "join_path", "source_concept": "LoanAccount", "target_concept": "CollectionCase", "name": "账户到催收案件", "description": "逾期账户可以进入一个或多个催收案件。", "join_path": [{"left": "loan_account_indicator.loan_id", "right": "collection_case_indicator.loan_id"}]},
    {"relation_key": "account_to_customer_risk", "relation_type": "join_path", "source_concept": "LoanAccount", "target_concept": "CustomerRiskSnapshot", "name": "客户到月度风险快照", "description": "贷款账户可通过客户ID连接到客户月度风险快照。", "join_path": [{"left": "loan_account_indicator.customer_id", "right": "customer_risk_monthly_indicator.customer_id"}]}
  ],
  "metrics": [
    {"metric_key": "approval_rate", "name": "审批通过率", "description": "approved 申请数 / 全部申请数。", "synonyms": ["通过率", "审批率", "申请通过率"], "metric_type": "ratio", "formula_sql": "SUM(CASE WHEN {base}.`approval_status` = 'approved' THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0)", "base_table": "loan_application_indicator", "time_field": "loan_application_indicator.apply_date", "dimensions": ["channel", "region", "risk_grade"]},
    {"metric_key": "application_count", "name": "申请笔数", "description": "贷款申请提交的笔数，按申请表 application_id 计数。", "synonyms": ["申请数", "申请量", "申请笔数", "进件量", "进件笔数", "贷款申请笔数", "贷款申请数"], "metric_type": "count", "formula_sql": "COUNT(*)", "base_table": "loan_application_indicator", "time_field": "loan_application_indicator.apply_date", "dimensions": ["application_region", "channel", "application_product_type", "application_risk_grade"]},
    {"metric_key": "disbursement_amount", "name": "放款金额", "description": "实际发放给客户的贷款本金金额。", "synonyms": ["放款本金", "贷款金额", "发放金额"], "metric_type": "measure", "formula_sql": "SUM({base}.`loan_amount`)", "base_table": "loan_account_indicator", "time_field": "loan_account_indicator.disburse_date", "dimensions": ["product_type", "vintage", "mob", "region", "channel", "risk_grade"]},
    {"metric_key": "outstanding_balance", "name": "余额", "description": "当前仍未偿还的贷款本金余额。", "synonyms": ["贷款余额", "剩余本金", "未还本金"], "metric_type": "measure", "formula_sql": "SUM({base}.`remaining_principal`)", "base_table": "loan_account_indicator", "time_field": "loan_account_indicator.snapshot_date", "dimensions": ["product_type", "vintage", "mob", "region", "channel", "risk_grade"]},
    {"metric_key": "m1_plus_rate", "name": "M1+逾期率", "description": "M1+贷款余额 / 对应贷款余额，M1+ 表示逾期阶段为 M1、M2、M3、M4+。", "synonyms": ["M1+", "M1以上", "30+逾期", "逾期率"], "metric_type": "ratio", "formula_sql": "SUM(CASE WHEN {base}.`overdue_bucket` IN ('M1', 'M2', 'M3', 'M4+') THEN {base}.`remaining_principal_after` ELSE 0 END) / NULLIF(SUM({base}.`remaining_principal_after`), 0)", "base_table": "loan_repayment_period_indicator", "time_field": "loan_repayment_period_indicator.due_date", "dimensions": ["product_type", "vintage", "mob", "region", "overdue_bucket"]},
    {"metric_key": "mob", "name": "MOB", "description": "放款后经过的月数。", "synonyms": ["账龄", "贷款账龄"], "metric_type": "dimension_metric", "formula_sql": "MAX({base}.`mob`)", "base_table": "loan_account_indicator", "time_field": "loan_account_indicator.snapshot_date", "dimensions": ["product_type", "vintage", "region"]},
    {"metric_key": "dpd", "name": "DPD", "description": "当前逾期天数。", "synonyms": ["逾期天数", "days past due"], "metric_type": "measure", "formula_sql": "MAX({base}.`current_overdue_days`)", "base_table": "loan_account_indicator", "time_field": "loan_account_indicator.snapshot_date", "dimensions": ["product_type", "vintage", "mob", "region"]},
    {"metric_key": "vintage", "name": "Vintage", "description": "按放款月份或放款批次观察风险表现。", "synonyms": ["放款批次", "放款月份"], "metric_type": "dimension_metric", "formula_sql": "COUNT(*)", "base_table": "loan_account_indicator", "time_field": "loan_account_indicator.disburse_date", "dimensions": ["vintage", "mob", "product_type", "region"]},
    {"metric_key": "pd", "name": "PD", "description": "预测违约概率。", "synonyms": ["违约概率", "预测违约概率"], "metric_type": "measure", "formula_sql": "AVG({base}.`model_pd`)", "base_table": "loan_application_indicator", "time_field": "loan_application_indicator.apply_date", "dimensions": ["channel", "region", "risk_grade", "vintage"]},
    {"metric_key": "dti", "name": "DTI", "description": "负债收入比。", "synonyms": ["负债收入比", "debt to income"], "metric_type": "measure", "formula_sql": "AVG({base}.`dti`)", "base_table": "customer_risk_monthly_indicator", "time_field": "customer_risk_monthly_indicator.stat_month", "dimensions": ["region", "customer_segment", "risk_grade"]},
    {"metric_key": "writeoff_amount", "name": "核销金额", "description": "已进入核销口径的贷款金额。", "synonyms": ["坏账金额", "核销", "writeoff amount"], "metric_type": "measure", "formula_sql": "SUM({base}.`writeoff_amount`)", "base_table": "loan_account_indicator", "time_field": "loan_account_indicator.snapshot_date", "default_filters": [{"field": "is_written_off", "operator": "=", "value": 1}], "dimensions": ["product_type", "vintage", "mob", "region"]},
    {"metric_key": "collection_recovery_rate", "name": "催收回收率", "description": "回收本金 / 入催逾期本金。", "synonyms": ["回收率", "催回率", "collection recovery rate"], "metric_type": "ratio", "formula_sql": "SUM({base}.`recovered_principal`) / NULLIF(SUM({base}.`entry_overdue_principal`), 0)", "base_table": "collection_case_indicator", "time_field": "collection_case_indicator.case_start_date", "dimensions": ["assigned_team", "collection_strategy", "overdue_bucket_at_entry", "product_type", "region"]}
  ],
  "rules": [
    {"rule_key": "m1_plus_definition", "rule_type": "definition", "name": "M1+口径", "description": "M1+ 通常表示逾期阶段为 M1、M2、M3、M4+，或 DPD 大于 30 天。", "expression": {"overdue_bucket": ["M1", "M2", "M3", "M4+"]}, "applies_to": ["m1_plus_rate"]},
    {"rule_key": "vintage_grouping", "rule_type": "definition", "name": "Vintage 默认口径", "description": "Vintage 默认按放款月份 disburse_month 分组，并结合 MOB 观察风险表现。", "expression": {"default_dimensions": ["vintage", "mob"]}, "applies_to": ["vintage", "m1_plus_rate"]},
    {"rule_key": "balance_priority", "rule_type": "definition", "name": "余额优先字段", "description": "账户当前余额优先使用 loan_account_indicator.remaining_principal。", "expression": {"field": "loan_account_indicator.remaining_principal"}, "applies_to": ["outstanding_balance"]},
    {"rule_key": "writeoff_filter", "rule_type": "filter", "name": "核销识别", "description": "核销贷款使用 is_written_off = 1 识别。", "expression": {"field": "is_written_off", "operator": "=", "value": 1}, "applies_to": ["writeoff_amount"]},
    {"rule_key": "collection_recovery_formula", "rule_type": "definition", "name": "催收回收率公式", "description": "催收回收率 = recovered_principal / entry_overdue_principal。", "expression": {"numerator": "recovered_principal", "denominator": "entry_overdue_principal"}, "applies_to": ["collection_recovery_rate"]},
    {"rule_key": "default_snapshot_date", "rule_type": "time", "name": "默认快照日期", "description": "未指定时间时，账户和催收快照类指标使用表内最新 snapshot_date 口径。", "expression": {"default": "latest_snapshot_date"}, "applies_to": ["outstanding_balance", "writeoff_amount", "dpd"]}
  ],
  "mappings": [
