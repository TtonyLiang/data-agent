  "templates": [
    {"template_key": "metric_query", "intent_type": "metric_query", "name": "指标查询", "description": "查询单个或多个指标，可带维度、过滤、时间窗口和排序。", "required_slots": ["metrics"], "optional_slots": ["dimensions", "filters", "time_range", "sort", "limit"], "compile_strategy": {"type": "metric_select"}, "examples": ["本月现金贷 M1+逾期率怎么算", "各催收团队催收回收率排名"]},
    {"template_key": "vintage_analysis", "intent_type": "metric_query", "name": "Vintage 分析", "description": "按放款批次和 MOB 观察风险表现。", "required_slots": ["metrics", "dimensions"], "optional_slots": ["filters", "time_range"], "compile_strategy": {"type": "metric_select"}, "examples": ["按 Vintage 看放款后 MOB3 的风险表现"]}
  ]
