    {"asset_type": "dimension", "asset_key": "overdue_bucket", "table_name": "loan_repayment_period_indicator", "column_name": "overdue_bucket", "data_type": "varchar", "role": "dimension"},
    {"asset_type": "filter", "asset_key": "is_written_off", "table_name": "loan_account_indicator", "column_name": "is_written_off", "data_type": "tinyint", "role": "filter"},
